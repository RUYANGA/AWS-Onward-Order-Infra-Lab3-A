style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#E7157B;fontColor=#E7157B;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ghapp" target="s3"><mxGeometry relative="1" as="geometry" x="0.63"></mxGeometry></mxCell><mxCell id="e_ecr_evb" value="④ :latest pushed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#E7157B;fontColor=#E7157B;dashed=1;" edge="1" parent="1" source="ecr" target="evb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_s3_cp" value="source" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#E7157B;fontColor=#E7157B;dashed=1;" edge="1" parent="1" source="s3" target="cp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_evb_cp" value="⑤ start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#E7157B;fontColor=#E7157B;dashed=1;" edge="1" parent="1" source="evb" target="cp"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cp_cd" value="⑥ deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#E7157B;fontColor=#E7157B;dashed=1;" edge="1" parent="1" source="cp" target="cd"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_cd_ecs" value="⑦ start green tasks, shift ALB traffic" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#E7157B;fontColor=#E7157B;dashed=1;exitX=0.25;exitY=1;entryX=1;entryY=0.98;" edge="1" parent="1" source="cd" target="ecsgrp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1682" y="925"/></Array></mxGeometry></mxCell><mxCell id="e_al_cd" value="alarm → auto rollback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#DD344C;fontColor=#DD344C;dashed=1;dashPattern=2 3;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" edge="1" parent="1" source="alarms" target="cd"><mxGeometry relative="1" as="geometry" x="-0.55"></mxGeometry></mxCell><mxCell id="e_aas_ecs" value="scale 2 to 6 tasks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#DD344C;fontColor=#DD344C;dashed=1;dashPattern=2 3;exitX=0.5;exitY=1;entryX=1;entryY=0.85;" edge="1" parent="1" source="aas" target="ecsgrp"><mxGeometry relative="1" as="geometry" x="-0.3"><Array as="points"><mxPoint x="1454" y="1180"/><mxPoint x="1080" y="1180"/><mxPoint x="1080" y="890"/></Array></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#232F3E'&gt;━━&lt;/font&gt; customer traffic and the security-group rule that allows it  ·  ┅ test listener&lt;br&gt;&lt;font color='#8C4FFF'&gt;┅┅&lt;/font&gt; private access to AWS from the tasks: interface endpoints (PrivateLink) and the S3 gateway endpoint&lt;br&gt;&lt;font color='#E7157B'&gt;┅┅&lt;/font&gt; delivery: ① GitHub OIDC → IAM role → ② image to ECR → ③ bundle to S3 → ④ EventBridge → ⑤ CodePipeline → ⑥ CodeDeploy → ⑦ blue/green on ECS&lt;br&gt;&lt;font color='#DD344C'&gt;┄┄&lt;/font&gt; control: alarms roll a bad release back automatically; auto scaling keeps 2 to 6 tasks&lt;br&gt;&lt;b&gt;Tasks have no public IP and no internet route. No AWS keys are stored: GitHub uses short-lived OIDC credentials, trusted only for the app repo's main branch.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F6F8FB;strokeColor=#D5DBE3;fontColor=#232F3E;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1400" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>